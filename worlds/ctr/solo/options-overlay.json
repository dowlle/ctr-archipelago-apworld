    {"option": "oxide_weapon_pool", "when": {"oxide_attack_profile": ["all_compatible"], "oxide_goal": ["none", "any_percent", "101_percent"]}, "at_least": 1, "reason": "N. Oxide's all_compatible profile needs 1 weapon."}
