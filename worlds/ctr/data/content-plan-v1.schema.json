      },
      "maxItems": 132,
      "minItems": 0
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Track"
      },
      "maxItems": 132,
      "minItems": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "maxItems": 33,
      "minItems": 0
    },
    "pads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Pad"
      },
      "maxItems": 32,
      "minItems": 32
    },
    "encounters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Encounter"
      },
      "maxItems": 6,
      "minItems": 0
    },
    "requirements": {
      "type": "array",
