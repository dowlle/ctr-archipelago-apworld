    },
    "goal": {
      "$ref": "#/$defs/Predicate"
    },
    "required_features": {
      "type": "array",
      "items": {
        "enum": [
          "content_plan_v1",
          "manual_pad_requirements_v1",
          "crystal_entries_v1",
          "crystal_pickups_v1",
          "arcade_crystals_v1",
          "track_modes_v1",
          "podium_rungs_v1",
          "wumpa_checks_v1",
          "lettersanity_v1",
          "relic_perfect_v1",
          "item_packs_v1",
          "character_unlocks_v1",
          "capability_packs_v1",
          "global_checks_v1",
          "item_boxes_v1",
          "cup_entries_v1",
          "boss_encounters_v1"
        ]
      },
      "maxItems": 17,
      "minItems": 1,
      "uniqueItems": true
    },
    "track_checks": {
      "$ref": "#/$defs/TrackChecks"
    },
    "item_packs": {
      "$ref": "#/$defs/ItemPacks"
    },
    "racers": {
      "$ref": "#/$defs/Racers"
    },
    "capability": {
      "$ref": "#/$defs/Capability"
    },
    "global_checks": {
      "$ref": "#/$defs/GlobalChecks"
    },
    "item_boxes": {
      "$ref": "#/$defs/ItemBoxes"
    },
    "bosses": {
      "$ref": "#/$defs/Bosses"
    }
  },
  "required": [
    "version",
    "packages",
    "tracks",
    "entries",
    "pads",
    "encounters",
    "requirements",
    "checks",
    "items",
    "goal",
    "required_features"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FilePin": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "lev",
            "vrm",
            "navigation",
            "ctr_letters",
            "relic_targets",
            "ap_boxes"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:/+\\-]+$"
        },
        "format_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "role",
        "sha256",
        "bytes",
        "format",
        "format_version"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:/+\\-]+$"
        },
        "file_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "maxItems": 6,
          "minItems": 1,
          "uniqueItems": true
        },
        "verifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:/+\\-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "level": {
          "enum": [
            "structural",
            "runtime"
          ]
        }
      },
      "required": [
        "capability",
        "file_hashes",
        "verifier",
        "revision",
        "level"
      ],
      "additionalProperties": false
    },
    "Package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:/+\\-]+$"
        },
        "content_id": {
          "description": "Registry track key, carried verbatim. The apworld looks the named id block up by this string; a key without a block uses a generic Custom Track slot (path B+). The wire name is kept so schema 1 plans stay compatible. The package id is \"package/<content_id>/<revision>\" and fits 64 bytes.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "laps": {
          "description": "Authored race laps (#133 PR 2). The Track record repeats it.",
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "capabilities": {
          "description": "Measured capability flags. Native measures the pinned bytes on load and refuses the package when a flag set to true is not there.",
          "type": "object",
          "properties": {
            "time_trial": {
              "type": "boolean"
            },
            "arcade": {
              "type": "boolean"
            },
            "relic": {
              "type": "boolean"
            },
            "ctr_tokens": {
              "type": "boolean"
            },
            "wumpa": {
              "type": "boolean"
            },
            "super_turbo_pads": {
              "description": "Optional (#133 PR 4c): the LEV has a trigger quad whose terrain byte carries the super turbo pad step flag. Native measures it and refuses a stated value the bytes disagree with. Absent counts as true in logic.",
              "type": "boolean"
            },
            "weapon_crates": {
              "description": "Optional (#133 PR 4e): how many weapon crates (PU_RANDOM_CRATE instances) the LEV holds. Native counts them and refuses a stated count the bytes disagree with. Item Box checks on a named-block track take min(count, 15) of them as seats; 0 also means the track is no Itemsanity route.",
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "checkpoints": {
              "description": "Optional (#133 PR 6b): the LEV's restart point count. Native measures it and refuses a stated count the bytes disagree with. With ai_nav true it lets the track race a boss under Boss Track Shuffle when the count carries the garage's attack schedule.",
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "ai_nav": {
              "description": "Optional (#133 PR 6b): the LEV has AI navigation paths. Native measures it and refuses a stated value the bytes disagree with. A boss venue needs it.",
              "type": "boolean"
            }
          },
          "required": [
            "time_trial",
            "arcade",
            "relic",
            "ctr_tokens",
            "wumpa"
          ],
          "additionalProperties": false
        },
        "relic_targets": {
          "description": "Present exactly when capabilities.relic is true. Ticks at 960 per second; sapphire > gold > platinum.",
          "type": "object",
          "properties": {
            "sapphire": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3456000
            },
            "gold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3456000
            },
            "platinum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3456000
            }
          },
          "required": [
            "sapphire",
            "gold",
            "platinum"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FilePin"
          },
          "maxItems": 2,
          "minItems": 2,
          "description": "Exactly the LEV pin, then the VRM pin."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 16,
          "minItems": 0,
          "description": "Informational. Every hash must be one of this package's file pins."
        }
      },
      "required": [
        "id",
        "content_id",
        "uuid",
        "revision",
        "display_name",
        "author",
        "laps",
        "capabilities",
        "files",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Track": {
